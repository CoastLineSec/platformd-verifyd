# platformd-verifyd presence-verification stack.
#
# platformd-verifyd runs only the auth phase of this stack to prove a user is
# present. List the factors to offer; the first successful factor verifies
# presence. PAM conversation prompts are forwarded to a systemd password agent.
#
# Enroll a fingerprint with fprintd-enroll before using pam_fprintd.

auth       sufficient   pam_fprintd.so
auth       required     pam_deny.so

account    required     pam_permit.so
