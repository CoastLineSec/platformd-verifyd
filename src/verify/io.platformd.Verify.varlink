# platformd-verifyd user-presence verification interface.
#
# Served on a system Varlink socket at $RUNTIME_DIRECTORY/io.platformd.Verify
# (/run/platformd-verifyd/io.platformd.Verify). No secret material crosses it.
interface io.platformd.Verify

# Challenge the calling user to prove presence now by running the platformd-verify
# PAM stack, using whichever factors the administrator configured. The
# user is the caller's own (taken from the peer credentials, never a claimed
# name), so a process may only verify itself. On
# success the verification may be recorded with platformd-trustd. sessionId
# names an active, local, logind-reported unlocked user session owned by the
# caller. If it is empty, the peer process session is used, or exactly one
# eligible session is selected. An invalid explicit session is not replaced by
# another session. reason is bounded descriptive text and does not identify a
# trusted client. The PAM conversation runs in a worker and the reply arrives
# when the factor completes. One request per user may run at a time, with a
# bounded number across the machine. The request is cancelled when its client
# disconnects or the target session becomes ineligible. verified is the outcome,
# and method is the PAM service that ran.
method VerifyUser(
        sessionId: string,
        reason: string
) -> (
        verified: bool,
        method: string,
        realtimeUSec: int
)

type MessageStyle (info, error)
type VerificationMessage (style: MessageStyle, text: string)
type VerificationResult (verified: bool, method: string, realtimeUSec: int)

# VerifyUser with PAM_TEXT_INFO/PAM_ERROR_MSG delivery. Requires more=true.
# Intermediate replies contain only message; the terminal reply contains only
# result, or an error. At most 32 messages of 1024 bytes each are delivered.
# Invalid messages, overflow, or failed delivery cancel the request. No input
# prompts or authentication responses are sent, and no message response is
# accepted. Messages are PAM module text, not a trusted application identity.
method VerifyUserWithMessages(sessionId: string, reason: string) -> (
        message: ?VerificationMessage,
        result: ?VerificationResult
)

type VerificationContext (
        challengeHex: string,
        audience: string,
        operationDigestHex: string
)

# VerifyUserWithMessages with immutable application-supplied context. The
# challenge and operation digest each contain exactly 32 bytes encoded as hex;
# submitted hex is lowercase. audience contains 1 through 256 printable ASCII
# bytes and is compared without normalization. Context is copied before PAM.
# On success, SubmitVerificationEvent is attempted asynchronously with the
# context and final verification completion timestamps, after worker cleanup
# and session validation. These are not timestamps of the PAM module return.
# The result reports PAM success, not
# measurement, remote acceptance, application identity, or operation approval.
# Context is not an authentication response and must not contain secrets.
method VerifyUserWithContext(sessionId: string, reason: string, context: VerificationContext) -> (
        message: ?VerificationMessage,
        result: ?VerificationResult
)

error PermissionDenied()
error VerificationUnsupported()
error VerificationTimedOut()
error VerificationCancelled()
error PromptUnavailable()
error NoSession()
error SessionNotEligible()
error AmbiguousSession()
error Busy()
